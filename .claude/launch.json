{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-v1-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--reload", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "frontend-v1-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "frontend", "dev", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "apps-api-v3",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "apps/api", "uvicorn", "graphrag_api.main:app", "--reload", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "apps-web-v3",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "apps/web", "dev", "-p", "3001"],
      "port": 3001
    }
  ]
}
