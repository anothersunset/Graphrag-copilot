# Templated Python CI workflow.
# DO NOT COMMIT THE RENDERED .yml FORM FROM THIS PROCESS DIRECTLY.
# Use:
#   make ci-activate           # renders sentinel tokens into GitHub expressions
# or:
#   bash scripts/install-workflows.sh
#
# Why sentinels: the AI agent's GitHub MCP integration cannot push files to
# .github/workflows/* (App scope), and its tool-call serializer strips
# consecutive double-braces. Sentinels survive both.

name: ci-python

on:
  push:
    branches: [main, "feat/**"]
  pull_request:
    branches: [main]

concurrency:
  group: ci-python-__GHA_OPEN__ github.ref __GHA_CLOSE__
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  quality:
    name: "py / root quality gates"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up uv
        uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true

      - name: Set up Python
        run: uv python install 3.12

      - name: Install workspace deps
        run: uv sync --all-packages --dev --python 3.12

      - name: Ruff
        run: uv run ruff check .

      - name: Pyright (basic)
        run: uv run pyright

      - name: Collect all tests together
        run: uv run pytest --collect-only -q

  tests:
    name: "pytest / __GHA_OPEN__ matrix.test_path __GHA_CLOSE__"
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        test_path:
          - apps/api/tests
          - packages/eval/tests
          - packages/graph/tests
          - packages/kg/tests
          - packages/observability/tests
          - packages/parsers/tests
          - packages/retrieval/tests
          - packages/schemas/tests
    steps:
      - uses: actions/checkout@v4

      - name: Set up uv
        uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true

      - name: Set up Python
        run: uv python install 3.12

      - name: Install workspace deps
        run: uv sync --all-packages --dev --python 3.12

      - name: Run package tests
        run: uv run pytest __GHA_OPEN__ matrix.test_path __GHA_CLOSE__ -q

  legacy-backend-syntax:
    name: "py / backend syntax gate"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Compile legacy backend sources
        run: |
          python -m compileall -q backend/main.py backend/config backend/app
